# Copiar a gateway/.env
PORT_GATEWAY=4000
# Puerto de mongoAPI (nombre heredado del boilerplate). Debe coincidir con services/mongoAPI/.env
PORT_CAMPAMENTOS=4001
# Puerto de auditAPI. Debe coincidir con services/auditAPI/.env
PORT_AUDITORIA=4003

# --- Despliegue (Render u otro host); en desarrollo no hace falta nada de esto ---
# Puerto del gateway: PORT_GATEWAY, si no el PORT que asigna Render, si no 4000.
# URL de cada subgrafo (por defecto http://localhost:<puerto>/graphql con los puertos de arriba).
# SUBGRAPH_MONGO_URL=http://localhost:4001/graphql
# SUBGRAPH_AUDIT_URL=http://localhost:4003/graphql
# AUDIT_ENABLED=false quita el subgrafo de auditoría (no hace falta ScyllaDB). Con false, `npm start`
# tampoco arranca auditAPI y desaparecen las consultas de la bitácora (auditEvents, auditByActor...).
# AUDIT_ENABLED=true
# Orígenes CORS permitidos, separados por comas, sin barra final (se quita si se escribe). Sin definir, CORS queda abierto.
# CORS_ORIGIN=https://pickaroo-dashboard.onrender.com
# Intentos de composición inicial (uno cada 2 s). Por defecto 15 y, con NODE_ENV=production, 90 (~3 min).
# GATEWAY_COMPOSE_RETRIES=90
# NODE_ENV=production quita el stacktrace de las respuestas de error (en los tres procesos).
# NODE_ENV=production
