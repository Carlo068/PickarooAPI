{
  "name": "pickarooapi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "gateway",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:campamentos": "npm run dev --workspace=services/mongoAPI",
    "dev:auditoria": "npm run dev --workspace=services/auditAPI",
    "dev": "npx concurrently -n api,audit,gateway \"npm run dev:campamentos\" \"npm run dev:auditoria\" \"npm run dev:gateway\"",
    "schema:build": "node scripts/build-schema.js",
    "schema:check": "node scripts/build-schema.js --check"
  },
  "devDependencies": {
    "@apollo/composition": "^2.14.4",
    "@apollo/federation-internals": "^2.14.4",
    "concurrently": "^8.2.2"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "protobufjs@7.6.5": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlo068/PickarooAPI.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Carlo068/PickarooAPI/issues"
  },
  "homepage": "https://github.com/Carlo068/PickarooAPI#readme"
}
