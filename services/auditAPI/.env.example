# Copiar a services/auditAPI/.env
# Lo que no se defina aquí se toma de services/mongoAPI/.env (p. ej. JWT_SECRET y REDIS_URL).
PORT_AUDITORIA=4003

# ScyllaDB
SCYLLADB_CONTACT_POINTS=127.0.0.1
SCYLLADB_PORT=9042
SCYLLADB_DATACENTER=datacenter1
SCYLLADB_KEYSPACE=pickaroo_audit

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=pickaroo.events

# Redis (sesiones)
REDIS_URL=redis://default:pickaroo123@localhost:6379

# Debe ser el mismo valor que en mongoAPI.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
