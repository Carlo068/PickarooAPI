# Copiar a services/auditAPI/.env
# Lo que no se defina aquí se toma de services/mongoAPI/.env (p. ej. JWT_SECRET y REDIS_URL).
PORT_AUDITORIA=4003

# ScyllaDB
SCYLLADB_CONTACT_POINTS=127.0.0.1
SCYLLADB_PORT=9042
SCYLLADB_DATACENTER=datacenter1
SCYLLADB_KEYSPACE=auditoria

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=eventos-seguridad
# Mensajes sin confirmar que recibe el worker a la vez (por omisión 50).
RABBITMQ_PREFETCH=50

# Redis (sesiones)
REDIS_URL=redis://default:pickaroo123@localhost:6379

# Debe ser el mismo valor que en mongoAPI.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# --- ScyllaDB alojado (p. ej. ScyllaDB Cloud); todo opcional, el valor por defecto es el Compose local ---
# Usuario y contraseña (PlainTextAuthProvider).
# SCYLLADB_USERNAME=scylla
# SCYLLADB_PASSWORD=
# TLS con verificación del certificado. SCYLLADB_SSL_REJECT_UNAUTHORIZED=false es un opt-out explícito.
# SCYLLADB_SSL=true
# SCYLLADB_SSL_REJECT_UNAUTHORIZED=true
# Hosts separados por comas (SCYLLADB_CONTACT_POINTS) y centro de datos local (SCYLLADB_DATACENTER, ej. AWS_US_EAST_1).
# SCYLLADB_CONTACT_POINTS=node-0.xxxxx.clusters.scylla.cloud,node-1.xxxxx.clusters.scylla.cloud
# SCYLLADB_DATACENTER=AWS_US_EAST_1
# SCYLLADB_CREATE_KEYSPACE=false omite CREATE KEYSPACE (el keyspace debe existir ya).
# SCYLLADB_CREATE_KEYSPACE=true
# Replicación del keyspace al crearlo: SimpleStrategy (por defecto) o NetworkTopologyStrategy, y su factor.
# SCYLLADB_REPLICATION_CLASS=SimpleStrategy
# SCYLLADB_REPLICATION_FACTOR=1
# Servicios alojados: RABBITMQ_URL=amqps://USUARIO:CONTRASENA@host/vhost  y  REDIS_URL=rediss://... (los mismos que mongoAPI).
# NODE_ENV=production
