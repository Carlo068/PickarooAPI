# Copiar a services/mongoAPI/.env
PORT_CAMPAMENTOS=4001

# MongoDB: usuario y contraseña de MONGO_INITDB_ROOT_* en docker-compose.yml
MONGODB_URI=mongodb://admin:CONTRASENA_DEL_COMPOSE@localhost:27017/pickaroodb?authSource=admin

# Redis (--requirepass del Compose)
REDIS_URL=redis://default:pickaroo123@localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=eventos-seguridad

# Neo4j (roles y permisos)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pickaroo123
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_MS=5000

# Sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Debe ser el mismo valor en auditAPI.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_TTL_SECONDS=3600
# Vida de cada refresh token (30 días); cada canje entrega uno nuevo con la vida completa.
REFRESH_TTL_SECONDS=2592000
# Ventana de gracia: un reintento con el refresh token recién canjeado recibe el mismo
# resultado durante estos segundos (respuesta perdida, canjes dobles); después cuenta como reutilización. 0 la desactiva.
REFRESH_REUSE_GRACE_SECONDS=10

# Caché y carrito (segundos)
CACHE_TTL_PRODUCT=120
CACHE_TTL_USER=3600
CACHE_DEBUG=false
CART_TTL_SECONDS=604800
QUOTE_TTL_SECONDS=900

# Última ubicación del repartidor (Redis driver:loc:<orderId>): vida de cada punto guardado.
# Si el repartidor deja de reportar, la posición caduca sola pasado este tiempo.
# Entero de 1 a 86400; cualquier otro valor usa 600.
DRIVER_LOCATION_TTL_SECONDS=600

# Datos de demostración al arrancar (solo desarrollo)
SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# Con NODE_ENV=production el seed NO usa las contraseñas públicas de demostración: exige definir las 8
# (SEED_ADMIN, SEED_CUSTOMER, SEED_MANAGER, SEED_STAFF, SEED_DELIVERY, SEED_DELIVERY2, SEED_HUERTA_MANAGER
# y SEED_HUERTA_STAFF, todas con sufijo _PASSWORD); si falta alguna, omite el seed y registra el error.
# Opcionales: sin definir, el seed usa las contraseñas de demostración del README (sección 11).
# También existen SEED_MANAGER_PASSWORD, SEED_STAFF_PASSWORD y SEED_DELIVERY_PASSWORD.

# --- Bases de datos alojadas (Render + planes gratuitos); sustituyen a los valores de arriba ---
# MongoDB Atlas M0:  MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/pickaroodb?retryWrites=true&w=majority
# Redis Cloud (Redis Stack, con JSON y Search):  REDIS_URL=redis://default:CONTRASENA@redis-12345.c1.us-east-1-2.ec2.redns.redis-cloud.com:12345
#   (rediss://... si la base tiene TLS)
# Neo4j AuraDB Free:  NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io  (NEO4J_USER=neo4j, NEO4J_PASSWORD de Aura)
# CloudAMQP:  RABBITMQ_URL=amqps://USUARIO:CONTRASENA@rattlesnake.rmq.cloudamqp.com/USUARIO
# Con AUDIT_ENABLED=false (sin auditAPI) deja RABBITMQ_URL sin definir: nadie consumiría la cola y se llenaría.
# En producción: NODE_ENV=production (sin stacktrace en los errores), SEED=true solo en el primer despliegue.
# NODE_ENV=production
