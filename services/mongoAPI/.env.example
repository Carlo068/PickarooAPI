# Copiar a services/mongoAPI/.env
PORT_CAMPAMENTOS=4001

# MongoDB: usuario y contraseña de MONGO_INITDB_ROOT_* en docker-compose.yml
MONGODB_URI=mongodb://admin:CONTRASENA_DEL_COMPOSE@localhost:27017/pickaroodb?authSource=admin

# Redis (--requirepass del Compose)
REDIS_URL=redis://default:pickaroo123@localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=pickaroo.events

# Neo4j (roles y permisos)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pickaroo123
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_MS=5000

# Sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Debe ser el mismo valor en auditAPI.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_TTL_SECONDS=3600

# Caché y carrito (segundos)
CACHE_TTL_PRODUCT=120
CACHE_TTL_USER=3600
CACHE_DEBUG=false
CART_TTL_SECONDS=604800
QUOTE_TTL_SECONDS=900

# Datos de demostración al arrancar (solo desarrollo)
SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# Opcionales: sin definir, el seed usa las contraseñas de demostración del README (sección 11).
# También existen SEED_MANAGER_PASSWORD, SEED_STAFF_PASSWORD y SEED_DELIVERY_PASSWORD.
